<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/study_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/session_banner"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/banner_card"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/warning"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nav_bar_bg"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/nav_home"
            style="@style/StudyNavItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_home"
                android:duplicateParentState="true"
                android:src="@drawable/ic_home"
                android:tint="@color/nav_item_color"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_home"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_dictionary"
            style="@style/StudyNavItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_dictionary"
                android:duplicateParentState="true"
                android:src="@drawable/ic_search"
                android:tint="@color/nav_item_color"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_dictionary"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tutor"
            style="@style/StudyNavItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_tutor"
                android:duplicateParentState="true"
                android:src="@drawable/ic_tutor"
                android:tint="@color/nav_item_color"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_tutor"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_vocabulary"
            style="@style/StudyNavItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_vocabulary"
                android:duplicateParentState="true"
                android:src="@drawable/ic_book"
                android:tint="@color/nav_item_color"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_vocabulary"
                android:textColor="@color/nav_item_color"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
