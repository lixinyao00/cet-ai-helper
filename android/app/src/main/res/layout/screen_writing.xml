<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/writing_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/writing_back"
                style="@style/StudyTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="4dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="10dp"
                android:text="@string/back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/writing_history_button"
                style="@style/StudyTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_history"
                android:drawablePadding="4dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="@string/writing_history" />
        </LinearLayout>

        <TextView
            style="@style/StudyHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/writing_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/writing_demo"
                style="@style/StudySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/writing_demo" />

            <Button
                android:id="@+id/writing_clear"
                style="@style/StudySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/clear_practice" />
        </LinearLayout>

        <TextView
            style="@style/StudyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:labelFor="@id/writing_prompt"
            android:text="@string/writing_prompt" />

        <EditText
            android:id="@+id/writing_prompt"
            style="@style/StudyField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:saveEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/StudyCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:labelFor="@id/writing_essay"
                android:text="@string/writing_essay" />

            <TextView
                android:id="@+id/writing_word_count"
                style="@style/StudyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/writing_word_count_hint" />
        </LinearLayout>

        <EditText
            android:id="@+id/writing_essay"
            style="@style/StudyField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="8"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:saveEnabled="false" />

        <Button
            android:id="@+id/writing_submit"
            style="@style/StudyPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/writing_submit" />

        <TextView
            android:id="@+id/writing_request_status"
            style="@style/StudyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <Button
            android:id="@+id/writing_retry"
            style="@style/StudySecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/retry"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/writing_review_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/writing_review_heading"
                style="@style/StudyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/writing_score_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/stat_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/StudyCaption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/estimated_score_label"
                        android:textColor="@color/accent" />

                    <TextView
                        android:id="@+id/writing_score_value"
                        style="@style/StudyStatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/writing_score_band"
                    style="@style/StudyCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <TextView
                android:id="@+id/writing_review_overall"
                style="@style/StudyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/writing_review_edited"
                style="@style/StudyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/tone_card"
                android:padding="8dp"
                android:text="@string/writing_review_edited"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/writing_issues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/writing_edit_essay"
                style="@style/StudySecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/writing_edit_essay" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
