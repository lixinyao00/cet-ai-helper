<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/import_review_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/StudyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_review" />

            <TextView
                android:id="@+id/import_review_hint"
                style="@style/StudyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/review_hint" />

            <EditText
                android:id="@+id/import_title"
                style="@style/StudyField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/import_title"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:singleLine="true" />

            <!-- Original Photo Reference Card (Collapsible) -->
            <LinearLayout
                android:id="@+id/import_review_image_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/StudyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_review_image_label" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/import_review_toggle_image"
                        style="@style/StudyTextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:text="@string/import_review_toggle_image" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/import_review_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/import_review_image_desc"
                    android:maxHeight="220dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <EditText
                android:id="@+id/import_body"
                style="@style/StudyField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top|start"
                android:hint="@string/import_body"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
                android:maxLength="50000"
                android:minLines="7"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

            <!-- Multi-page Append Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/import_review_append_camera"
                    style="@style/StudySecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_camera"
                    android:drawablePadding="6dp"
                    android:text="@string/import_review_append_camera"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/import_review_append_gallery"
                    style="@style/StudySecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_gallery"
                    android:drawablePadding="6dp"
                    android:text="@string/import_review_append_gallery"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/import_review_status"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/import_cancel"
            style="@style/StudySecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/cancel_import" />

        <Button
            android:id="@+id/import_confirm"
            style="@style/StudyPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/confirm_import" />
    </LinearLayout>
</LinearLayout>
