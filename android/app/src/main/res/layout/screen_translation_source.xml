<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <Button
            android:id="@+id/translation_back"
            style="@style/StudyTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="4dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="10dp"
            android:text="@string/back" />

        <TextView
            style="@style/StudyHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/translation_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/translation_capture"
                style="@style/StudySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_camera"
                android:drawablePadding="6dp"
                android:text="@string/capture_import"
                android:textSize="13sp" />

            <Button
                android:id="@+id/translation_pick"
                style="@style/StudySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_gallery"
                android:drawablePadding="6dp"
                android:text="@string/pick_import"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/StudyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:labelFor="@id/translation_source_input"
            android:text="@string/translation_source_label" />

        <EditText
            android:id="@+id/translation_source_input"
            style="@style/StudyField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="5"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:saveEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/translation_demo"
                style="@style/StudySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/translation_demo_source" />

            <Button
                android:id="@+id/translation_clear"
                style="@style/StudySecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/clear_practice" />
        </LinearLayout>

        <Button
            android:id="@+id/translation_start"
            style="@style/StudyPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/translation_start" />
    </LinearLayout>
</ScrollView>
