# CetHelper Server 环境变量示例（复制为 .env 或在启动前 export；切勿提交真实密钥）

# 运行模式：demo（默认，内置语料零配置可跑）| live（调用兼容 OpenAI Chat Completions 接口）
CET_EXPLANATION_MODE=demo

# live 模式必填（CET_EXPLANATION_MODE=live 时启用）
CET_MODEL_BASE_URL=https://api.openai.com/v1
CET_MODEL_NAME=gpt-4o-mini
CET_MODEL_API_KEY=sk-REPLACE_ME

# 模型请求超时（ISO-8601 时长）
CET_MODEL_CONNECT_TIMEOUT=PT3S
CET_MODEL_READ_TIMEOUT=PT20S
CET_ARTICLE_READ_TIMEOUT=PT45S

# 会话凭证有效期（ISO-8601 时长，默认 72 小时）
CET_TOKEN_TTL=PT72H

# 可选 MySQL 存储（需配合 SPRING_PROFILES_ACTIVE=mysql）
# SPRING_PROFILES_ACTIVE=mysql
# CET_DB_URL=jdbc:mysql://127.0.0.1:3306/cet_helper?characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# CET_DB_USERNAME=cet_app
# CET_DB_PASSWORD=REPLACE_ME
