<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sentence_scroll" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="4dp">

        <TextView android:id="@+id/analysis_mode" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/pill"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textColor="@color/accent" android:textSize="12sp"
            android:text="@string/analysis_demo" android:visibility="gone" />

        <TextView android:id="@+id/analysis_original" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:fontFamily="serif" android:textSize="18sp" android:textColor="@color/ink"
            android:textDirection="ltr" />

        <TextView android:id="@+id/analysis_status" style="@style/StudyCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <Button android:id="@+id/analysis_retry" style="@style/StudyPrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/retry" android:visibility="gone" />

        <LinearLayout android:id="@+id/analysis_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/StudyCaption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium" android:text="@string/analysis_translation" />
            <TextView android:id="@+id/analysis_translation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:textSize="17sp" android:textColor="@color/ink" />

            <TextView style="@style/StudyCaption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium" android:text="@string/analysis_structure" />
            <TextView android:id="@+id/analysis_structure" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:textSize="15sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" />

            <TextView style="@style/StudyCaption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium" android:text="@string/analysis_fragment_hint" />
            <LinearLayout android:id="@+id/analysis_fragments" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
