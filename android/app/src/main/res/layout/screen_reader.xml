<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/reader_back" style="@style/StudyTextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/back" />
        <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
        <Button android:id="@+id/reader_vocabulary" style="@style/StudyTextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/vocabulary" />
    </LinearLayout>

    <ScrollView android:id="@+id/article_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="14dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/reader_title" style="@style/StudyHeading"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="serif" />

            <TextView style="@style/StudyCaption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/reader_hint" />

            <LinearLayout android:id="@+id/article_paragraphs" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/explanation_panel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp" android:orientation="vertical" android:padding="14dp"
        android:background="@drawable/card" android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/panel_selection" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="@color/ink" android:fontFamily="serif"
                android:maxLines="2" android:ellipsize="end" android:textSize="22sp" />
            <Button android:id="@+id/panel_back_to_word" style="@style/StudyTextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/analysis_return_to_word" android:visibility="gone" />
            <Button android:id="@+id/panel_close" style="@style/StudyTextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/dismiss_explanation" />
        </LinearLayout>

        <ScrollView android:id="@+id/panel_scroll" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="4dp">
                <TextView android:id="@+id/panel_mode" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/pill"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:textColor="@color/accent" android:textSize="12sp"
                    android:text="@string/demo" android:visibility="gone" />
                <TextView android:id="@+id/panel_meaning" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textColor="@color/ink" android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" android:visibility="gone" />
                <TextView android:id="@+id/panel_detail" style="@style/StudyCaption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/panel_word_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button android:id="@+id/panel_action" style="@style/StudyPrimaryButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:visibility="gone" />
            <Button android:id="@+id/panel_analyze" style="@style/StudyTextButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/analyze_sentence"
                android:visibility="gone" />
        </LinearLayout>

        <include layout="@layout/panel_sentence_analysis" />
    </LinearLayout>
</LinearLayout>
