<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/tone_card"
    android:orientation="vertical"
    android:padding="12dp">

    <Button
        android:id="@+id/review_issue_quote"
        style="@style/StudyTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="40dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />

    <TextView
        android:id="@+id/review_issue_detail"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/review_issue_suggestion"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/review_issue_candidates"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
