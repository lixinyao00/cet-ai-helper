<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/writing_answer_status" style="@style/StudyCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />

    <LinearLayout android:id="@+id/writing_assessment_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp" android:padding="12dp"
        android:background="@drawable/card" android:visibility="gone">
        <TextView android:id="@+id/writing_answer_verdict" style="@style/StudyHeading"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="17sp" android:accessibilityLiveRegion="polite" />
        <TextView style="@style/StudyCaption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/writing_answer_snapshot" />
        <TextView android:id="@+id/writing_answer_snapshot" style="@style/StudyCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/ink"
            android:textIsSelectable="true" android:saveEnabled="false" />
        <TextView android:id="@+id/writing_answer_candidates" style="@style/StudyCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:visibility="gone" />
        <TextView android:id="@+id/writing_answer_feedback" style="@style/StudyCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/writing_answer_next_step" style="@style/StudyCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/ink" />
    </LinearLayout>
</LinearLayout>
