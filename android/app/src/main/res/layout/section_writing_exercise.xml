<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/writing_exercise" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">

    <TextView style="@style/StudyHeading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="17sp" android:text="@string/writing_exercise_title" />
    <TextView android:id="@+id/writing_exercise_instruction" style="@style/StudyCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/writing_exercise_item" style="@style/StudyCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/ink" />
    <TextView style="@style/StudyCaption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:labelFor="@id/writing_exercise_answer" android:text="@string/writing_exercise_answer" />
    <EditText android:id="@+id/writing_exercise_answer" style="@style/StudyField"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:inputType="textMultiLine|textCapSentences" android:gravity="top|start"
        android:saveEnabled="false" android:importantForAutofill="no" />
    <Button android:id="@+id/writing_exercise_submit" style="@style/StudyPrimaryButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/writing_answer_submit" />
    <include android:id="@+id/writing_exercise_result" layout="@layout/section_writing_assessment"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button android:id="@+id/writing_request_retest" style="@style/StudyTextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/writing_request_retest" />
    <TextView android:id="@+id/writing_retest_status" style="@style/StudyCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <include layout="@layout/section_writing_retest" />
</LinearLayout>
