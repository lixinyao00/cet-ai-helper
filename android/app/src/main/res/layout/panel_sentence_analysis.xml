<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sentence_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/analysis_mode"
            style="@style/StudyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analysis_demo"
            android:visibility="gone" />

        <TextView
            android:id="@+id/analysis_original"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tone_card"
            android:fontFamily="serif"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textDirection="ltr"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/analysis_status"
            style="@style/StudyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <Button
            android:id="@+id/analysis_retry"
            style="@style/StudyPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/retry"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/analysis_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/StudyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/analysis_translation"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/analysis_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                style="@style/StudyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/analysis_structure"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/analysis_structure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                style="@style/StudyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/analysis_fragment_hint"
                android:textColor="@color/accent" />

            <LinearLayout
                android:id="@+id/analysis_fragments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/analysis_ask_tutor"
                style="@style/StudySecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ask_tutor"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
