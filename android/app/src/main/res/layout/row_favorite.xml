<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card" android:padding="14dp">
    <TextView android:id="@+id/favorite_term" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/ink"
        android:fontFamily="serif" android:textSize="23sp" />
    <TextView android:id="@+id/favorite_meaning" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/accent"
        android:textSize="16sp" />
    <TextView android:id="@+id/favorite_sentence" style="@style/StudyCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
    <TextView android:id="@+id/favorite_article" style="@style/StudyCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
    <Button android:id="@+id/favorite_jump" style="@style/StudyTextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:text="@string/return_to_article" />
</LinearLayout>
