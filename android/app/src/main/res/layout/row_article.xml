<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/imported_article"
            style="@style/StudyTextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_book"
            android:drawablePadding="10dp"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/article_row_delete"
            style="@style/StudyDangerTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_delete"
            android:drawablePadding="4dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:text="@string/article_delete"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/article_row_meta"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="36dp"
        android:paddingEnd="4dp"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
