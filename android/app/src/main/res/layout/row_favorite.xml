<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/favorite_term"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/favorite_level"
            style="@style/StudyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/favorite_source"
            style="@style/StudyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/favorite_row_mastery"
            style="@style/StudyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/favorite_row_phonetic"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/favorite_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/accent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/favorite_sentence"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/tone_card"
        android:padding="10dp"
        android:textDirection="ltr" />

    <TextView
        android:id="@+id/favorite_article"
        style="@style/StudyCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/favorite_row_delete"
            style="@style/StudyDangerTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_delete"
            android:drawablePadding="4dp"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/vocabulary_delete"
            android:visibility="gone" />

        <Button
            android:id="@+id/favorite_jump"
            style="@style/StudyTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/return_to_article" />
    </LinearLayout>
</LinearLayout>
